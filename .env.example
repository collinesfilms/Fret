# ─── Identity ────────────────────────────────────────────────────────────────

# Shown in the interface and the browser tab. Rename the instance freely.
FRET_APP_NAME=Fret

# The canonical origin recipients will see. Used to build share links and, by
# default, the OIDC redirect URL. No trailing slash.
FRET_PUBLIC_URL=https://fret.example.com

# Interface language: en or fr. Instance-wide — per-user settings live in the
# app itself, not here.
FRET_LOCALE=en

FRET_LISTEN=:8080
FRET_DATA_DIR=/data

# Signs session and sign-in cookies. Generate with: openssl rand -hex 32
# Changing it signs everyone out. Fret refuses to start without it.
FRET_SESSION_SECRET=

# ─── Storage ─────────────────────────────────────────────────────────────────

# Fret needs two addresses for the same bucket when they differ, which is the
# usual case for a self-hosted MinIO:
#
#   PUBLIC   the address the BROWSER can reach. Upload and download URLs are
#            signed against it, and the browser talks to it directly.
#   INTERNAL the address THIS SERVER uses for its own reads (assembling an
#            archive). A LAN address here avoids a round trip out and back.
#
# On a managed provider they are the same; set only the public one.
FRET_S3_PUBLIC_ENDPOINT=https://s3.example.com
FRET_S3_INTERNAL_ENDPOINT=http://minio:9000

FRET_S3_BUCKET=fret
FRET_S3_REGION=us-east-1
FRET_S3_ACCESS_KEY=
FRET_S3_SECRET_KEY=

# MinIO, Garage and most self-hosted gateways need path-style addressing.
# Set false for AWS S3.
FRET_S3_FORCE_PATH_STYLE=true

# How long a signed URL stays usable. The upload window has to outlast a slow
# transfer; the download window should be short, since it is the only thing
# standing between a leaked URL and the file.
FRET_PRESIGN_UPLOAD_TTL=6h
FRET_PRESIGN_DOWNLOAD_TTL=15m

# ─── Sign-in ─────────────────────────────────────────────────────────────────

# Fret creates no accounts and stores no passwords. Anyone your provider lets
# in can send files.
FRET_OIDC_ISSUER=https://id.example.com
FRET_OIDC_CLIENT_ID=
FRET_OIDC_CLIENT_SECRET=
# Defaults to FRET_PUBLIC_URL + /auth/callback. Register this with your
# provider as the allowed redirect URL.
#FRET_OIDC_REDIRECT_URL=
FRET_OIDC_SCOPES=openid,profile,email
FRET_SESSION_TTL=720h

# ─── Operations ──────────────────────────────────────────────────────────────

# The OIDC subject or email address allowed to see bucket-wide usage. Checked
# server-side; a client can never claim it. Leave empty for no superadmin.
FRET_SUPERADMIN=

# How often expired transfers are deleted and abandoned uploads discarded.
FRET_SWEEP_INTERVAL=10m

# An upload with no activity for this long is abandoned and its storage
# reclaimed. Must comfortably exceed a realistic pause in a large transfer.
FRET_ORPHAN_MAX_AGE=24h
